# Sunder — environment template.
#
# Copy to `.env` for local development. NEVER commit the filled-in file.
# In production these live in GitHub Secrets (see docs/spec.md section 14).

# --- Supabase --------------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co

# Public by design; the frontend ships it and RLS is what protects the data.
SUPABASE_ANON_KEY=

# SECRET. Bypasses RLS. Only ever available to the sync/backup workflows.
# Must never reach the frontend build, the repository, or any log output.
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption ------------------------------------------------------------
# 32 bytes, hex-encoded. Generate with: openssl rand -hex 32
# SECRET. Encrypts Garmin credentials at rest; deliberately never stored in the
# database, so a database leak alone does not expose any password.
ENCRYPTION_KEY=

# 32 bytes, hex-encoded. Generate with: openssl rand -hex 32
# SECRET. Encrypts the nightly database dump produced by backup.yml.
BACKUP_ENCRYPTION_KEY=

# --- Frontend (apps/web) ---------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Only public values are allowed here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
